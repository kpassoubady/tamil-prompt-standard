{
  "bookTitle": "தமிழில் செய்யறிவைக் கட்டளையிடும் கலை",
  "outputFilename": "Tamil-Prompt-Engineering-Book-Showcase.pdf",
  "author": "Kangeyan Passoubady",
  "pageSettings": {
    "header": "{title}",
    "headerFallback": "{bookTitle}",
    "headerRight": "{page} of {pages}",
    "footerLeft": "{date}",
    "footerCenter": "",
    "footerRight": "Kangs | Kavin School",
    "dateFormat": "%B %d, %Y"
  },
  "styleSettings": {
    "pageSize": "6in 9in",
    "margins": "0.75in 0.6in 0.75in 0.8in",
    "fontFamily": "Helvetica Neue, Helvetica, Arial, sans-serif",
    "monoFontFamily": "SF Mono, Monaco, Menlo, Consolas, Liberation Mono, monospace",
    "bodyFontSize": "9.5pt",
    "bodyLineHeight": "1.5",
    "bodyColor": "#333333",
    "headingColor": "#222222",
    "h1FontSize": "13pt",
    "h2FontSize": "11.5pt",
    "h3FontSize": "10.5pt",
    "h4FontSize": "10pt",
    "codeFontSize": "8.5pt",
    "tableFontSize": "8.5pt",
    "codeBackground": "#f5f5f5",
    "linkColor": "#0066cc",
    "headerFontSize": "10px",
    "footerFontSize": "9px"
  },
  "tocSettings": {
    "titleFontSize": 18,
    "subtitleFontSize": 12,
    "subtitleText": "உள்ளடக்க அட்டவணை",
    "entryFontSize": 10,
    "footerFontSize": 8,
    "lineColor": "#0066CC",
    "entryColor": "#0066CC",
    "footerColor": "#666666"
  },
  "imageOptimization": {
    "default": {
      "maxWidth": 800,
      "maxHeight": 1000,
      "jpegQuality": 75,
      "convertToJpeg": true
    },
    "covers": {
      "maxWidth": 2400,
      "maxHeight": 3200,
      "jpegQuality": 95,
      "convertToJpeg": false
    }
  },
  "contentProcessing": {
    "promptHandling": {
      "enabled": true,
      "label": "▶ PROMPT",
      "backgroundColor": "#EBF5FF",
      "borderColor": null,
      "borderWidth": "3px",
      "outlineColor": "#CCE0F5",
      "borderRadius": "4px",
      "padding": "10px 14px",
      "labelFontSize": "7.5pt",
      "labelColor": null
    },
    "admonitionHandling": {
      "enabled": true,
      "style": "boxed",
      "includeIcons": true,
      "customTypes": {
        "PROMPT": {
          "label": "▶ PROMPT",
          "backgroundColor": "#EBF5FF",
          "borderColor": "#0066CC",
          "borderWidth": "3px",
          "outlineColor": "#CCE0F5",
          "borderRadius": "4px",
          "labelColor": "#0066CC",
          "labelFontSize": "7.5pt",
          "useBodyFont": true,
          "labelSeparator": true
        }
      }
    },
    "blockquoteListHandling": {
      "enabled": true
    },
    "titledListHandling": {
      "enabled": true
    },
    "detailsTagHandling": {
      "enabled": true,
      "staticFormats": [
        "pdf",
        "epub"
      ],
      "staticReplacement": {
        "showSummary": true,
        "summaryText": "விடைகள்:",
        "addHorizontalRule": true
      }
    }
  },
