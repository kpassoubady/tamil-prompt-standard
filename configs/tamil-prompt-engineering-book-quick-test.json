{
  "bookTitle": "The Art of Commanding AI in Tamil",
  "outputFilename": "Tamil-Prompt-Engineering-Book-show-case.pdf",
  "author": "Kangeyan Passoubady",
  "language": "en-US",
  "showMainToc": false,
  "pageSettings": {
    "header": "{title}",
    "headerFallback": "{bookTitle}",
    "headerRight": "{page} of {pages}",
    "footerLeft": "",
    "footerCenter": "கட்டளைத் தமிழ்",
    "footerRight": "",
    "dateFormat": "%B %d, %Y"
  },
  "styleSettings": {
    "pageSize": "6in 9in",
    "margins": "0.75in 0.6in 0.75in 0.8in",
    "fontFamily": "Helvetica Neue, Helvetica, Arial, sans-serif",
    "monoFontFamily": "SF Mono, Monaco, Menlo, Consolas, Liberation Mono, monospace",
    "bodyFontSize": "9.5pt",
    "bodyLineHeight": "1.5",
    "bodyColor": "#333333",
    "headingColor": "#222222",
    "h1FontSize": "13pt",
    "h2FontSize": "11.5pt",
    "h3FontSize": "10.5pt",
    "h4FontSize": "10pt",
    "codeFontSize": "8.5pt",
    "tableFontSize": "8.5pt",
    "codeBackground": "#f5f5f5",
    "linkColor": "#0066cc",
    "headerFontSize": "10px",
    "footerFontSize": "9px",
    "allPageBorderImages": [
      "/Users/kangs/github/tamil-prompt-standard/book/images/assets/background-2.png"
    ]
  },
  "tocSettings": {
    "titleFontSize": 12,
    "subtitleFontSize": 8,
    "subtitleText": "Table of Contents",
    "entryFontSize": 8,
    "footerFontSize": 8,
    "lineColor": "#0066CC",
    "entryColor": "#0066CC",
    "footerColor": "#666666",
    "showMainToc": false,
    "altTocTitle": "கட்டளைத் தமிழ் - தூண்டுவினா நுட்பம்",
    "altTocSubtitle": "உள்ளடக்கம்",
    "altTocPageLabel": "பக்."
  },
  "imageOptimization": {
    "default": {
      "maxWidth": 800,
      "maxHeight": 1000,
      "jpegQuality": 75,
      "convertToJpeg": true
    },
    "covers": {
      "maxWidth": 2400,
      "maxHeight": 3200,
      "jpegQuality": 95,
      "convertToJpeg": false
    }
  },
  "contentProcessing": {
    "promptHandling": {
      "enabled": true,
      "label": "▶ PROMPT",
      "backgroundColor": "#EBF5FF",
      "borderColor": null,
      "borderWidth": "3px",
      "outlineColor": "#CCE0F5",
      "borderRadius": "4px",
      "padding": "10px 14px",
      "labelFontSize": "7.5pt",
      "labelColor": null
    },
    "admonitionHandling": {
      "enabled": true,
      "labelLanguage": "ta",
      "style": "boxed",
      "includeIcons": true,
      "customTypes": {
        "PROMPT": {
          "label": "▶ தூண்டுவினா",
          "backgroundColor": "#EBF5FF",
          "borderColor": "#0066CC",
          "borderWidth": "3px",
          "outlineColor": "#CCE0F5",
          "borderRadius": "4px",
          "labelColor": "#0066CC",
          "labelFontSize": "7.5pt",
          "useBodyFont": true,
          "labelSeparator": true
        },
        "POEM": {
          "label": "",
          "backgroundColor": "#f0fff4",
          "borderColor": "#4CAF50",
          "borderWidth": "3px",
          "outlineColor": "#c8e6c9",
          "borderRadius": "4px",
          "useBodyFont": true
        }
      }
    },
    "footnoteHandling": {
      "enabled": true
    },
    "blockquoteListHandling": {
      "enabled": true
    },
    "titledListHandling": {
      "enabled": true
    },
    "imageCaptions": {
      "enabled": true
    },
    "detailsTagHandling": {
      "enabled": true,
      "staticFormats": [
        "pdf",
        "epub"
      ],
      "staticReplacement": {
        "showSummary": true,
        "summaryText": "Answers:",
        "addHorizontalRule": true
      }
    }
  },
  "chapters": [
    {
      "section": "Front Cover",
      "files": [
        "book/cover-intro/front-cover.md",
        "book/images/front-cover.png"
      ],
      "note": "PNG file is required for EPUB format cover"
    },
    {
      "section": "Introduction",
      "tocLabel": "அறிமுகம்",
      "files": [
        "book/cover-intro/book-introduction.md"
      ]
    },
    {
      "section": "Absolute Beginner Guide",
      "tocLabel": "செய்யறிவு (AI) கணக்கைத் தொடங்குவது எப்படி?",
      "files": [
        "book/cover-intro/absolute-beginner-guide.md"
      ]
    },
    {
      "section": "Back Cover",
      "files": [
        "book/final-pages/back-cover.md",
        "book/images/back-cover.png"
      ]
    }
  ]
}