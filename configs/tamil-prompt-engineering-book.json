{
  "bookTitle": "கட்டளைத் தமிழ் — The Art of Commanding AI in Tamil",
  "outputFilename": "Tamil-Prompt-Engineering-Book.pdf",
  "author": "Kangeyan Passoubady",
  "pageSettings": {
    "header": "{title}",
    "headerFallback": "{bookTitle}",
    "footerLeft": "{date}",
    "footerCenter": "Page {page} of {pages}",
    "footerRight": "Tamil Prompt Standard",
    "dateFormat": "%B %d, %Y"
  },
  "styleSettings": {
    "pageSize": "A4",
    "margins": "1in 0.8in 1in 0.8in",
    "fontFamily": "Noto Sans, Helvetica Neue, Arial, sans-serif",
    "monoFontFamily": "SF Mono, Monaco, Menlo, Consolas, Liberation Mono, monospace",
    "bodyFontSize": "11pt",
    "bodyLineHeight": "1.6",
    "bodyColor": "#333333",
    "headingColor": "#222222",
    "h1FontSize": "18pt",
    "h2FontSize": "16pt",
    "h3FontSize": "14pt",
    "h4FontSize": "12pt",
    "codeFontSize": "10pt",
    "tableFontSize": "10pt",
    "codeBackground": "#f5f5f5",
    "linkColor": "#0066cc",
    "headerFontSize": "12px",
    "footerFontSize": "10px"
  },
  "tocSettings": {
    "titleFontSize": 24,
    "subtitleFontSize": 14,
    "subtitleText": "Table of Contents — உள்ளடக்கம்",
    "entryFontSize": 11,
    "footerFontSize": 9,
    "lineColor": "#CC3300",
    "entryColor": "#CC3300",
    "footerColor": "#666666"
  },
  "imageOptimization": {
    "default": {
      "maxWidth": 800,
      "maxHeight": 1000,
      "jpegQuality": 75,
      "convertToJpeg": true
    },
    "covers": {
      "maxWidth": 2400,
      "maxHeight": 3200,
      "jpegQuality": 95,
      "convertToJpeg": false
    }
  },
  "contentProcessing": {
    "admonitionHandling": {
      "enabled": true,
      "style": "boxed",
      "includeIcons": true
    },
    "blockquoteListHandling": {
      "enabled": true
    },
    "titledListHandling": {
      "enabled": true
    },
    "detailsTagHandling": {
      "enabled": true,
      "staticFormats": ["pdf", "epub"],
      "staticReplacement": {
        "showSummary": true,
        "summaryText": "விடைகள் (Answers):",
        "addHorizontalRule": true
      }
    }
  },
